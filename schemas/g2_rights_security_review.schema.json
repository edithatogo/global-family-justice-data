{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/g2_rights_security_review.schema.json",
  "title": "G2 source-specific rights, privacy, security and disclosure review",
  "type": "object",
  "required": [
    "schema_version", "review_id", "packet_id", "packet_sha256", "candidate_id",
    "source_id", "source_edition_id", "content_sha256", "canonical_url",
    "acquisition_receipt", "terms_evidence", "rights_observations",
    "permitted_acts", "prohibited_acts", "attribution_conditions",
    "privacy_inspection", "binary_security_inspection", "disclosure_inspection",
    "findings", "critical_finding_count", "high_finding_count",
    "proposed_disposition", "uncertainties", "owner_decision_required",
    "panel_report", "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_id": {"type": "string", "pattern": "^G2RS-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_id": {"type": "string", "pattern": "^G2PKT-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "source_edition_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_url": {"type": "string", "format": "uri"},
    "acquisition_receipt": {"$ref": "#/$defs/artifact"},
    "terms_evidence": {"type": "array", "items": {"$ref": "#/$defs/dated_artifact"}},
    "rights_observations": {
      "type": "object",
      "required": ["copyright", "database_rights", "third_party_components", "signed_agreement"],
      "properties": {
        "copyright": {"enum": ["clear", "restricted", "ambiguous", "not_applicable"]},
        "database_rights": {"enum": ["clear", "restricted", "ambiguous", "not_applicable"]},
        "third_party_components": {"enum": ["none_found", "present", "ambiguous", "not_assessed"]},
        "signed_agreement": {"enum": ["none", "present", "required", "unknown"]}
      },
      "additionalProperties": false
    },
    "permitted_acts": {"type": "array", "items": {"type": "string"}},
    "prohibited_acts": {"type": "array", "items": {"type": "string"}},
    "attribution_conditions": {"type": "array", "items": {"type": "string"}},
    "privacy_inspection": {"$ref": "#/$defs/inspection"},
    "binary_security_inspection": {"$ref": "#/$defs/inspection"},
    "disclosure_inspection": {"$ref": "#/$defs/inspection"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "critical_finding_count": {"type": "integer", "minimum": 0},
    "high_finding_count": {"type": "integer", "minimum": 0},
    "proposed_disposition": {"enum": ["private_analysis", "metadata_only", "quarantined", "redistributable", "excluded"]},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "owner_decision_required": {"const": true},
    "panel_report": {"$ref": "#/$defs/artifact"},
    "authority_boundary": {"const": "factual_agent_review_not_legal_advice_or_rights_clearance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "dated_artifact": {
      "type": "object", "required": ["path", "sha256", "accessed_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "accessed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "inspection": {
      "type": "object", "required": ["method", "status", "evidence"],
      "properties": {
        "method": {"type": "string", "minLength": 2},
        "status": {"enum": ["passed", "findings", "incomplete", "not_applicable"]},
        "evidence": {"$ref": "#/$defs/artifact"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object", "required": ["finding_id", "severity", "description", "status"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 2},
        "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
        "description": {"type": "string", "minLength": 3},
        "status": {"enum": ["open", "mitigated", "resolved", "accepted_by_owner"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
