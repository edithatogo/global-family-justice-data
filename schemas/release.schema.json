{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/release.schema.json",
  "title": "GFJD release metadata",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "version",
    "status",
    "created_at",
    "contract_version",
    "ontology_version",
    "programme_gate",
    "counts",
    "validation",
    "archive"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "const": "GFJD"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "release_candidate",
        "stable"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "contract_version": {
      "type": "string"
    },
    "ontology_version": {
      "type": "string"
    },
    "programme_gate": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "validation": {
      "type": "object"
    },
    "archive": {
      "type": "object"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication": {
      "type": "object",
      "required": ["authorized", "authority_reference"],
      "additionalProperties": false,
      "properties": {
        "authorized": {"type": "boolean"},
        "authority_reference": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": false
}
