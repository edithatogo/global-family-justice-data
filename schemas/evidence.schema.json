{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/evidence.schema.json",
  "title": "Outcomes evidence catalogue row",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "jurisdiction_id",
    "title",
    "publisher",
    "official_status",
    "evidence_type",
    "publication_date",
    "matter_types",
    "population",
    "study_design",
    "outcome_domains",
    "source_url",
    "provenance_locator",
    "review_status",
    "second_reviewed"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidence_id": {"type": "string", "minLength": 3},
    "jurisdiction_id": {"type": "string", "minLength": 2},
    "source_id": {"type": "string"},
    "title": {"type": "string"},
    "publisher": {"type": "string"},
    "official_status": {"enum": ["official", "authoritative_method", "peer_reviewed", "non_government", "other"]},
    "evidence_type": {"enum": ["routine_administrative", "user_survey", "legal_needs_survey", "evaluation", "cohort", "linked_administrative", "qualitative", "mixed_methods", "systematic_review", "other"]},
    "publication_date": {"type": "string", "format": "date"},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "language": {"type": "string"},
    "matter_types": {"type": "string"},
    "population": {"type": "string"},
    "study_setting": {"type": "string"},
    "study_design": {"type": "string"},
    "comparator": {"type": "string"},
    "sample_size": {"type": ["integer", "null"], "minimum": 0},
    "data_sources": {"type": "string"},
    "outcome_domains": {"type": "string"},
    "outcome_measures": {"type": "string"},
    "effect_estimates_available": {"enum": ["yes", "no", "unclear"]},
    "reusable_aggregate_data": {"enum": ["yes", "no", "unclear"]},
    "peer_reviewed": {"enum": ["yes", "no", "unclear"]},
    "risk_of_bias": {"enum": ["low", "some_concerns", "high", "not_assessed", "not_applicable"]},
    "quality_grade": {"enum": ["A", "B", "C", "D", "E", "ungraded"]},
    "source_url": {"type": "string", "format": "uri"},
    "provenance_locator": {"type": "string"},
    "review_status": {"enum": ["draft", "provisional", "reviewed", "approved", "withdrawn"]},
    "reviewer": {"type": "string"},
    "second_reviewed": {"enum": ["yes", "no"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
