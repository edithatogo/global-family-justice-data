{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indicator dictionary row",
  "type": "object",
  "required": [
    "schema_version",
    "indicator_id",
    "domain",
    "name",
    "definition",
    "preferred_statistic",
    "preferred_unit",
    "core_release",
    "status",
    "introduced_in",
    "reviewed_for_v1"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "indicator_id": {"type": "string", "minLength": 3},
    "domain": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "definition": {"type": "string", "minLength": 1},
    "preferred_statistic": {"type": "string", "minLength": 1},
    "preferred_unit": {"type": "string", "minLength": 1},
    "numerator": {"type": "string"},
    "denominator": {"type": "string"},
    "core_release": {"enum": ["yes", "no"]},
    "comparability_notes": {"type": "string"},
    "status": {"enum": ["draft", "active", "deprecated", "withdrawn"]},
    "introduced_in": {"type": "string"},
    "reviewed_for_v1": {"enum": ["yes", "no"]},
    "replacement_indicator_id": {"type": "string"}
  },
  "additionalProperties": false
}
