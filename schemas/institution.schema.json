{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/institution.schema.json",
  "title": "Institution register row",
  "type": "object",
  "required": [
    "institution_id",
    "jurisdiction_id",
    "name",
    "institution_type",
    "court_level",
    "valid_from",
    "valid_to",
    "status",
    "notes"
  ],
  "properties": {
    "institution_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"
    },
    "jurisdiction_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "institution_type": {
      "type": "string",
      "minLength": 2
    },
    "court_level": {
      "type": "string"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "status": {
      "enum": [
        "active",
        "historic",
        "planned",
        "unknown"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
