    "resource_budget": {"const": {"maximum_candidates": 44, "maximum_bytes_per_edition": 104857600, "maximum_total_source_bytes": 4613734400, "maximum_pages_per_edition": 2000, "maximum_total_pages": 44000, "minimum_free_working_storage_bytes": 16106127360, "maximum_redirects": 3, "maximum_retries_per_candidate": 2, "maximum_concurrency": 2, "estimated_agent_hours_low": 80, "estimated_agent_hours_high": 176, "owner_hours_low": 2, "owner_hours_high": 4}},
    "authorization": {
