{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/direct_enquiry.schema.json",
  "title": "Priority-gap direct enquiry record",
  "type": "object",
  "required": ["enquiry_id", "jurisdiction_id", "priority", "state", "sent_at", "closed_at", "evidence_path", "review_status", "notes"],
  "properties": {
    "enquiry_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "state": {"enum": ["planned", "sent", "answered", "closed_no_response", "not_required"]},
    "sent_at": {"type": ["string", "null"], "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_path": {"type": "string"},
    "review_status": {"enum": ["draft", "reviewed", "accepted", "rejected", "superseded"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
