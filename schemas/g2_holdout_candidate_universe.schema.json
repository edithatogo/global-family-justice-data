{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_holdout_candidate_universe.schema.json",
  "title": "G2 metadata-only blind-holdout candidate universe",
  "type": "object",
  "required": ["schema_version", "universe_id", "design_id", "as_of", "metadata_only", "source_content_accessed", "candidates", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "universe_id": {"type": "string", "pattern": "^G2HOLDOUT-UNIVERSE-[A-Z0-9_-]+$"},
    "design_id": {"const": "G2HOLDOUT-PROSPECTIVE-20260815-01"},
    "as_of": {"type": "string", "format": "date-time"},
    "metadata_only": {"const": true},
    "source_content_accessed": {"const": false},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "screen": {"enum": ["no_known_metadata_blocker", "uncertain", "blocked"]},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "edition_id", "edition_title", "jurisdiction_id", "source_series_id", "publisher", "official_publisher", "landing_page_url", "source_url", "edition_date_or_period", "languages", "format", "proposed_stratum", "supported_strata", "stratum_support", "stratum_basis", "exact_edition_identity_established", "metadata_evidence_urls", "terms_url", "rights_url", "privacy_url", "security_url", "terms_screen", "rights_screen", "rights_screen_rationale", "privacy_screen", "security_screen", "prohibited_data_screen", "eligibility", "checked_at", "source_content_accessed", "notes"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^G2CAND-[A-Z0-9_-]+$"},
        "edition_id": {"type": "string", "minLength": 3},
        "edition_title": {"type": "string", "minLength": 3},
        "jurisdiction_id": {"type": "string", "minLength": 2},
        "source_series_id": {"type": "string", "minLength": 3},
        "publisher": {"type": "string", "minLength": 2},
        "official_publisher": {"type": "boolean"},
        "landing_page_url": {"type": "string", "format": "uri"},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "edition_date_or_period": {"type": "string", "minLength": 1},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2,3}$"}},
        "format": {"enum": ["pdf", "non_pdf", "uncertain"]},
        "proposed_stratum": {"type": ["string", "null"], "enum": ["english_text_native", "non_english_text_native", "embedded_raster_or_dashboard_pdf", "structurally_complex_mixed_layout_pdf", null]},
        "supported_strata": {"type": "array", "uniqueItems": true, "items": {"enum": ["english_text_native", "non_english_text_native", "embedded_raster_or_dashboard_pdf", "structurally_complex_mixed_layout_pdf"]}},
        "stratum_support": {"enum": ["supported_by_public_metadata", "uncertain_without_content_inspection", "contradicted"]},
        "stratum_basis": {"type": "string", "minLength": 10},
        "exact_edition_identity_established": {"type": "boolean"},
        "metadata_evidence_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "terms_url": {"type": ["string", "null"], "format": "uri"},
        "rights_url": {"type": ["string", "null"], "format": "uri"},
        "privacy_url": {"type": ["string", "null"], "format": "uri"},
        "security_url": {"type": ["string", "null"], "format": "uri"},
        "terms_screen": {"$ref": "#/$defs/screen"},
        "rights_screen": {"$ref": "#/$defs/screen"},
        "rights_screen_rationale": {"type": "string", "minLength": 10},
        "privacy_screen": {"$ref": "#/$defs/screen"},
        "security_screen": {"$ref": "#/$defs/screen"},
        "prohibited_data_screen": {"$ref": "#/$defs/screen"},
        "eligibility": {"enum": ["eligible_metadata_only", "ineligible", "uncertain"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "source_content_accessed": {"const": false},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
