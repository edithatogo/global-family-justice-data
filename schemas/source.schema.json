{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source register row",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "jurisdiction_id",
    "title",
    "publisher",
    "official_status",
    "source_type",
    "source_url",
    "licence_status",
    "rights_reviewed",
    "redistribution_decision",
    "priority",
    "last_verified",
    "source_status",
    "review_status",
    "next_review_due"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_id": {
      "type": "string",
      "minLength": 3
    },
    "jurisdiction_id": {
      "type": "string",
      "minLength": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "type": "string"
    },
    "official_status": {
      "enum": [
        "official",
        "authoritative_method",
        "peer_reviewed",
        "non_government",
        "other"
      ]
    },
    "source_type": {
      "type": "string"
    },
    "frequency": {
      "type": "string"
    },
    "coverage_note": {
      "type": "string"
    },
    "matter_types": {
      "type": "string"
    },
    "measure_domains": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "access_method": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "licence_status": {
      "type": "string",
      "minLength": 1
    },
    "rights_reviewed": {
      "enum": [
        "yes",
        "no"
      ]
    },
    "redistribution_decision": {
      "enum": [
        "unknown",
        "metadata_only",
        "redistributable",
        "restricted",
        "not_applicable"
      ]
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "source_status": {
      "enum": [
        "active",
        "changed",
        "superseded",
        "unavailable",
        "withdrawn",
        "unverified"
      ]
    },
    "source_version": {
      "type": "string"
    },
    "archived_url": {
      "type": "string"
    },
    "checksum_sha256": {
      "type": "string",
      "pattern": "^$|^[a-f0-9]{64}$"
    },
    "review_status": {
      "enum": [
        "draft",
        "provisional",
        "reviewed",
        "approved",
        "withdrawn"
      ]
    },
    "next_review_due": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
