{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_atomic_boundary_correction.schema.json",
  "title": "Documented G2 atomic source-boundary correction",
  "type": "object",
  "required": [
    "schema_version", "correction_id", "basis_policy", "basis_policy_sha256",
    "prior_packet_id", "prior_packet_sha256", "prior_comparison_sha256",
    "prior_differences_sha256", "advisory_report_sha256", "classification",
    "critical_threshold", "overall_threshold", "fields", "unchanged_invariants",
    "requires_both_runs", "publication_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "correction_id": {"type": "string", "pattern": "^G2COR-[A-Z0-9_-]{5,80}$"},
    "basis_policy": {"type": "string", "minLength": 1},
    "basis_policy_sha256": {"$ref": "#/$defs/sha256"},
    "prior_packet_id": {"const": "G2PKT-REAL-PILOT-20260815-02"},
    "prior_packet_sha256": {"$ref": "#/$defs/sha256"},
    "prior_comparison_sha256": {"$ref": "#/$defs/sha256"},
    "prior_differences_sha256": {"$ref": "#/$defs/sha256"},
    "advisory_report_sha256": {"$ref": "#/$defs/sha256"},
    "classification": {"const": "boundary_only_no_semantic_change"},
    "critical_threshold": {"const": 1.0},
    "overall_threshold": {"const": 0.99},
    "fields": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["sample_key", "source_record_key", "field", "required_value", "basis"],
        "properties": {
          "sample_key": {"type": "string", "minLength": 1},
          "source_record_key": {"$ref": "#/$defs/sha256"},
          "field": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "required_value": {"type": "string", "minLength": 1},
          "basis": {"enum": ["exact_source_element", "exact_source_substring"]}
        },
        "additionalProperties": false
      }
    },
    "unchanged_invariants": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requires_both_runs": {"const": true},
    "publication_authorized": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
  "additionalProperties": false
}
