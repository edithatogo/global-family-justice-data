{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/observation.schema.json",
  "title": "Normalised family-justice observation",
  "type": "object",
  "required": [
    "schema_version", "observation_id", "record_status", "jurisdiction_id", "subnational_id", "institution_id", "court_level", "matter_type_original", "matter_type_harmonised", "proceeding_type", "measure_original", "indicator_id", "local_measure_id", "stage_start", "stage_end", "statistic_type", "unit", "count_unit", "value", "denominator_value", "denominator_definition", "period_start", "period_end", "time_basis", "cohort_basis", "population_scope", "definition_original", "definition_english", "source_id", "source_edition_id", "provenance_locator", "extraction_id", "transformation_rule_id", "review_id", "extraction_method", "reviewer", "second_reviewer", "second_reviewed", "review_status", "quality_grade", "comparability_tier", "release_eligible", "suppression_status", "break_in_series", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observation_id": {"type": "string", "pattern": "^OBS_[A-Z0-9][A-Z0-9_-]{7,95}$"},
    "record_status": {"enum": ["draft", "in_review", "accepted", "quarantined", "superseded"]},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "subnational_id": {"type": ["string", "null"]},
    "institution_id": {"type": ["string", "null"]},
    "court_level": {"type": ["string", "null"]},
    "matter_type_original": {"type": "string", "minLength": 1},
    "matter_type_harmonised": {"type": "string", "pattern": "^MAT_[A-Z0-9_]{2,60}$"},
    "proceeding_type": {"type": ["string", "null"]},
    "measure_original": {"type": "string", "minLength": 1},
    "indicator_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "local_measure_id": {"type": ["string", "null"]},
    "stage_start": {"type": ["string", "null"]},
    "stage_end": {"type": ["string", "null"]},
    "statistic_type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "unit": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "count_unit": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "denominator_value": {"type": ["number", "null"]},
    "denominator_definition": {"type": ["string", "null"]},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "time_basis": {"enum": ["calendar", "working", "source_defined", "not_applicable", "unknown"]},
    "cohort_basis": {"type": "string", "minLength": 2},
    "population_scope": {"type": "string", "minLength": 2},
    "definition_original": {"type": "string", "minLength": 3},
    "definition_english": {"type": "string", "minLength": 3},
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{4,79}$"},
    "source_edition_id": {"type": ["string", "null"]},
    "provenance_locator": {"type": "string", "minLength": 2},
    "extraction_id": {"type": ["string", "null"]},
    "transformation_rule_id": {"type": ["string", "null"]},
    "review_id": {"type": ["string", "null"]},
    "extraction_method": {"enum": ["api", "structured_file", "html_table", "dashboard_export", "manual_pdf", "manual_other", "other"]},
    "reviewer": {"type": "string", "minLength": 2},
    "second_reviewer": {"type": ["string", "null"]},
    "second_reviewed": {"type": "boolean"},
    "review_status": {"enum": ["unreviewed", "in_review", "accepted", "rejected", "quarantined"]},
    "quality_grade": {"enum": ["A", "B", "C", "D", "E"]},
    "comparability_tier": {"type": "integer", "minimum": 1, "maximum": 4},
    "release_eligible": {"type": "boolean"},
    "suppression_status": {"enum": ["not_assessed", "not_required", "review_required", "suppressed"]},
    "break_in_series": {"type": "boolean"},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
