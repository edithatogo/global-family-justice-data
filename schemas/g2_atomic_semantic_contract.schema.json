{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_atomic_semantic_contract.schema.json",
  "title": "Frozen G2 packet-02 atomic semantic extraction contract",
  "type": "object",
  "required": [
    "schema_version", "contract_id", "owner_decision", "owner_decision_sha256",
    "supersedes_packet_id", "row_schema", "critical_fields", "ignored_fields",
    "normalization", "date_rule", "samples", "publication_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"type": "string", "pattern": "^G2ASC-[A-Z0-9_-]{5,80}$"},
    "owner_decision": {"type": "string", "minLength": 1},
    "owner_decision_sha256": {"$ref": "#/$defs/sha256"},
    "supersedes_packet_id": {"const": "G2PKT-REAL-PILOT-20260815-01"},
    "row_schema": {"$ref": "#/$defs/path"},
    "critical_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "ignored_fields": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "normalization": {
      "type": "object",
      "required": ["unicode", "whitespace", "case", "punctuation", "quotes", "numbers"],
      "properties": {
        "unicode": {"const": "NFC"},
        "whitespace": {"const": "collapse_to_single_ascii_space_and_trim"},
        "case": {"const": "preserve_source"},
        "punctuation": {"const": "preserve_source"},
        "quotes": {"const": "exact_instruction_bounded_source_excerpt"},
        "numbers": {"const": "source_published_no_recalculation"}
      },
      "additionalProperties": false
    },
    "date_rule": {"const": "explicit_exact_edition_only_otherwise_null"},
    "samples": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "sample_key", "source_record_key", "required_component_keys",
          "canonical_codes", "required_ambiguity_codes", "quarantine_status", "excerpt_boundaries"
        ],
        "properties": {
          "sample_key": {"type": "string", "minLength": 1},
          "source_record_key": {"$ref": "#/$defs/sha256"},
          "required_component_keys": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "canonical_codes": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9_]+$"},
            "additionalProperties": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "required_ambiguity_codes": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          },
          "quarantine_status": {"enum": ["quarantine", "hard_quarantine"]},
          "excerpt_boundaries": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9_]+$"},
            "additionalProperties": {"type": ["string", "null"]}
          }
        },
        "additionalProperties": false
      }
    },
    "publication_authorized": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
