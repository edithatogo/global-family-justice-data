{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/source.schema.json",
  "title": "Source register row",
  "type": "object",
  "required": [
    "source_id",
    "jurisdiction_id",
    "title",
    "publisher",
    "source_class",
    "official_status",
    "source_type",
    "frequency",
    "coverage_note",
    "matter_types",
    "measure_domains",
    "format",
    "access_method",
    "language",
    "source_url",
    "licence_status",
    "priority",
    "last_verified",
    "notes"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{4,79}$"},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "title": {"type": "string", "minLength": 3},
    "publisher": {"type": "string", "minLength": 2},
    "source_class": {"enum": ["international", "international_method", "national", "subnational", "research", "non_government"]},
    "official_status": {"enum": ["official", "authoritative_method", "non_government"]},
    "source_type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "frequency": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "coverage_note": {"type": "string", "minLength": 3},
    "matter_types": {"type": "string", "minLength": 2},
    "measure_domains": {"type": "string", "minLength": 2},
    "format": {"type": "string", "minLength": 2},
    "access_method": {"type": "string", "minLength": 2},
    "language": {"type": "string", "minLength": 2},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "licence_status": {
      "enum": [
        "open_licence_verified",
        "public_domain_verified",
        "government_open_data_check",
        "government_terms_check",
        "commonwealth_copyright_check",
        "crown_copyright_check",
        "open_or_crown_check",
        "restricted_or_unknown",
        "unknown"
      ]
    },
    "priority": {"enum": ["high", "medium", "low"]},
    "last_verified": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
