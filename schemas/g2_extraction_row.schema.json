{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/g2_extraction_row.schema.json",
  "title": "G2 source-native blinded extraction row",
  "type": "object",
  "required": [
    "schema_version", "extracted_row_id", "source_record_key", "candidate_id",
    "source_id", "source_edition_id", "provenance_locator", "measure_original",
    "matter_type_original", "statistic_type", "unit", "value", "component_values",
    "denominator_value", "denominator_definition", "period_start", "period_end",
    "time_basis", "cohort_basis", "population_scope",
    "suppression_or_disclosure_note", "extraction_uncertainty", "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "extracted_row_id": {"type": "string", "pattern": "^G2ROW-[A-Z0-9][A-Z0-9_-]{5,95}$"},
    "source_record_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "source_edition_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "provenance_locator": {"type": "string", "minLength": 2},
    "measure_original": {"type": "string", "minLength": 1},
    "matter_type_original": {"type": "string", "minLength": 1},
    "statistic_type": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "unit": {"type": "string", "minLength": 1},
    "value": {"type": ["number", "null"]},
    "component_values": {
      "type": "object",
      "description": "Additional source-published numeric facts required by the frozen four-row target. Every populated component is compared as critical evidence.",
      "propertyNames": {"pattern": "^[a-z0-9_]+$"},
      "additionalProperties": {"type": ["number", "null"]}
    },
    "denominator_value": {"type": ["number", "null"]},
    "denominator_definition": {"type": ["string", "null"]},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "time_basis": {"enum": ["calendar", "working", "source_defined", "not_applicable", "unknown"]},
    "cohort_basis": {"type": "string", "minLength": 1},
    "population_scope": {"type": "string", "minLength": 1},
    "suppression_or_disclosure_note": {"type": ["string", "null"]},
    "extraction_uncertainty": {"enum": ["none", "low", "material", "unresolved"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
