{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/g2/prospective-calibration-row-2.0.schema.json",
  "title": "Prospective G2 calibration row",
  "type": "object",
  "required": [
    "schema_version", "extracted_row_id", "sample_key", "source_record_key",
    "candidate_id", "source_id", "source_edition_id", "source_format", "locator",
    "domain_label_source", "domain_code", "matter_label_source", "matter_type_code",
    "measure_label_source", "indicator_code", "series_label_source", "series_code",
    "statistic_label_source", "statistic_type", "unit_label_source", "unit_code", "value", "component_values",
    "denominator_value", "denominator_definition_quote", "denominator_code",
    "period_label_source", "period_start", "period_end", "period_start_provenance",
    "period_end_provenance", "clock_label_source", "clock_code",
    "cohort_definition_quote", "cohort_code", "counted_entity_label_source",
    "counted_entity_code", "population_scope_label_source", "population_scope_code",
    "coverage_limitation_quote", "ambiguity_codes", "ambiguity_evidence_quote",
    "quarantine_status", "suppression_or_disclosure_note", "extraction_uncertainty",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "extracted_row_id": {"type": "string", "pattern": "^G2ROW-[A-Z0-9][A-Z0-9_-]{5,95}$"},
    "sample_key": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{5,119}$"},
    "source_record_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^G2CAND-[A-Z0-9][A-Z0-9_-]{5,95}$"},
    "source_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "source_edition_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,95}$"},
    "source_format": {"enum": ["api", "csv", "html", "json", "ods", "pdf", "spreadsheet", "xlsx"]},
    "locator": {
      "type": "object",
      "required": ["pdf_page", "printed_page", "section_source", "object_source", "machine_locator"],
      "properties": {
        "pdf_page": {"type": ["integer", "null"], "minimum": 1},
        "printed_page": {"type": ["integer", "null"], "minimum": 1},
        "section_source": {"$ref": "#/$defs/nullable_source_text"},
        "object_source": {"$ref": "#/$defs/nullable_source_text"},
        "machine_locator": {"$ref": "#/$defs/nullable_source_text"}
      },
      "additionalProperties": false
    },
    "domain_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "domain_code": {"$ref": "#/$defs/semantic_code"},
    "matter_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "matter_type_code": {"$ref": "#/$defs/semantic_code"},
    "measure_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "indicator_code": {"$ref": "#/$defs/semantic_code"},
    "series_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "series_code": {"enum": ["source_defined", "unknown", null]},
    "statistic_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "statistic_type": {"$ref": "#/$defs/semantic_code"},
    "unit_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "unit_code": {"$ref": "#/$defs/semantic_code"},
    "value": {"type": "number"},
    "component_values": {"type": "object", "maxProperties": 0, "additionalProperties": false},
    "denominator_value": {"type": ["number", "null"]},
    "denominator_definition_quote": {"$ref": "#/$defs/nullable_source_text"},
    "denominator_code": {"enum": ["not_applicable", "source_defined", "unknown"]},
    "period_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "period_start": {"type": ["string", "null"], "format": "date"},
    "period_end": {"type": ["string", "null"], "format": "date"},
    "period_start_provenance": {"$ref": "#/$defs/date_provenance"},
    "period_end_provenance": {"$ref": "#/$defs/date_provenance"},
    "clock_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "clock_code": {"enum": ["calendar_days", "not_applicable", "source_defined", "unknown", "working_days"]},
    "cohort_definition_quote": {"$ref": "#/$defs/nullable_source_text"},
    "cohort_code": {"$ref": "#/$defs/semantic_code"},
    "counted_entity_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "counted_entity_code": {"$ref": "#/$defs/semantic_code"},
    "population_scope_label_source": {"$ref": "#/$defs/nullable_source_text"},
    "population_scope_code": {"$ref": "#/$defs/semantic_code"},
    "coverage_limitation_quote": {"$ref": "#/$defs/nullable_source_text"},
    "ambiguity_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["clock_conflict", "cohort_conflict", "coverage_limitation", "date_not_stated", "denominator_conflict", "ontology_conflict", "period_not_stated", "population_conflict", "source_definition_conflict", "source_value_conflict", "suppression_or_disclosure_ambiguity"]}
    },
    "ambiguity_evidence_quote": {"$ref": "#/$defs/nullable_source_text"},
    "quarantine_status": {"const": "hard_quarantine"},
    "suppression_or_disclosure_note": {"type": ["string", "null"]},
    "extraction_uncertainty": {"enum": ["none", "unresolved"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "source_text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\r\\n\\t])(?!.* {2}).+$"},
    "nullable_source_text": {"anyOf": [{"$ref": "#/$defs/source_text"}, {"type": "null"}]},
    "semantic_code": {"enum": ["source_defined", "unknown"]},
    "date_provenance": {"enum": ["explicit_source", "not_stated"]}
  },
  "allOf": [
    {"if": {"properties": {"source_format": {"const": "pdf"}}}, "then": {"properties": {"locator": {"properties": {"pdf_page": {"type": "integer", "minimum": 1}}}}}, "else": {"properties": {"locator": {"properties": {"pdf_page": {"type": "null"}, "machine_locator": {"$ref": "#/$defs/source_text"}}}}}},
    {"if": {"properties": {"period_start": {"type": "null"}}}, "then": {"properties": {"period_start_provenance": {"const": "not_stated"}}}, "else": {"properties": {"period_start_provenance": {"const": "explicit_source"}}}},
    {"if": {"properties": {"period_end": {"type": "null"}}}, "then": {"properties": {"period_end_provenance": {"const": "not_stated"}}}, "else": {"properties": {"period_end_provenance": {"const": "explicit_source"}}}},
    {"if": {"properties": {"ambiguity_codes": {"minItems": 1}}}, "then": {"properties": {"ambiguity_evidence_quote": {"$ref": "#/$defs/source_text"}, "extraction_uncertainty": {"const": "unresolved"}}}},
    {"if": {"properties": {"domain_code": {"const": "source_defined"}}}, "then": {"properties": {"domain_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"matter_type_code": {"const": "source_defined"}}}, "then": {"properties": {"matter_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"indicator_code": {"const": "source_defined"}}}, "then": {"properties": {"measure_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"series_code": {"const": "source_defined"}}}, "then": {"properties": {"series_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"statistic_type": {"const": "source_defined"}}}, "then": {"properties": {"statistic_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"unit_code": {"const": "source_defined"}}}, "then": {"properties": {"unit_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"denominator_code": {"const": "source_defined"}}}, "then": {"properties": {"denominator_definition_quote": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"denominator_code": {"const": "not_applicable"}}}, "then": {"properties": {"denominator_value": {"type": "null"}, "denominator_definition_quote": {"type": "null"}}}},
    {"if": {"properties": {"cohort_code": {"const": "source_defined"}}}, "then": {"properties": {"cohort_definition_quote": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"counted_entity_code": {"const": "source_defined"}}}, "then": {"properties": {"counted_entity_label_source": {"$ref": "#/$defs/source_text"}}}},
    {"if": {"properties": {"population_scope_code": {"const": "source_defined"}}}, "then": {"properties": {"population_scope_label_source": {"$ref": "#/$defs/source_text"}}}}
  ],
  "additionalProperties": false
}
