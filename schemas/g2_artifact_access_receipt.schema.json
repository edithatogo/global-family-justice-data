{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_artifact_access_receipt.schema.json",
  "title": "G2 role-isolated artifact access receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "plan_id", "role", "session_id", "fresh_session_attested", "role_bundle", "authority", "network_mode", "network_url_allowlist", "input_bundle", "path_allowlist", "artifact_class_denylist", "output_prefix", "access_events", "denied_access_attempts", "violations", "started_at", "ended_at", "tool_bundle", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0"}, "receipt_id": {"type": "string", "minLength": 8},
    "plan_id": {"const": "G2HOLDOUT-STRUCTURAL-PREFLIGHT-20260815-01"},
    "role": {"enum": ["metadata_url_resolver", "exposure_auditor", "frame_freezer", "acquisition_custodian", "binary_security_scanner", "structural_eligibility_reviewer", "eligibility_verifier", "deterministic_selector", "packet_sealer", "primary_extractor", "secondary_extractor", "comparator", "postseal_advisory_panel"]},
    "session_id": {"type": "string", "minLength": 8}, "fresh_session_attested": {"const": true},
    "role_bundle": {"$ref": "#/$defs/artifact"}, "authority": {"$ref": "#/$defs/artifact"},
    "network_mode": {"enum": ["none", "exact_allowlist_only"]},
    "network_url_allowlist": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "input_bundle": {"$ref": "#/$defs/artifact"},
    "path_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_class_denylist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_prefix": {"type": "string", "minLength": 1},
    "access_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/access_event"}},
    "denied_access_attempts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "violations": {"type": "array", "maxItems": 0},
    "started_at": {"type": "string", "format": "date-time"}, "ended_at": {"type": "string", "format": "date-time"},
    "tool_bundle": {"$ref": "#/$defs/artifact"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/access_event"}}
  },
  "allOf": [
    {"if": {"properties": {"network_mode": {"const": "none"}}}, "then": {"properties": {"network_url_allowlist": {"maxItems": 0}}}},
    {"if": {"properties": {"network_mode": {"const": "exact_allowlist_only"}}}, "then": {"properties": {"network_url_allowlist": {"minItems": 1}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "access_event": {"type": "object", "required": ["artifact_class", "path", "sha256"], "properties": {"artifact_class": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
