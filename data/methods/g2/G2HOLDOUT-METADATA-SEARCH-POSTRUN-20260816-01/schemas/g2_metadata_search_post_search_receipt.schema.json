{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/postrun/g2_metadata_search_post_search_receipt.schema.json",
  "title": "G2 metadata-search post-run verification receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "generated_at", "registrar_bundle", "registrar_boundary_receipt", "registrar_event_log", "post_execution_commit_attestation", "query_manifest", "design_manifest", "authority_receipt", "immutable_bindings_reverified", "successor_semantic_verification", "boundary_counts", "outbound_contacts", "candidate_content_opened", "source_content_opened", "panel_inputs_allowed", "status", "g2_passage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"const": "G2-METADATA-SEARCH-POST-SEARCH-VERIFICATION"},
    "generated_at": {"type": "string", "format": "date-time"},
    "registrar_bundle": {"$ref": "#/$defs/artifact"},
    "registrar_boundary_receipt": {"$ref": "#/$defs/artifact"},
    "registrar_event_log": {"$ref": "#/$defs/artifact"},
    "post_execution_commit_attestation": {"$ref": "#/$defs/artifact"},
    "query_manifest": {"$ref": "#/$defs/artifact"},
    "design_manifest": {"$ref": "#/$defs/artifact"},
    "authority_receipt": {"$ref": "#/$defs/artifact"},
    "immutable_bindings_reverified": {"const": true},
    "successor_semantic_verification": {"const": "passed"},
    "boundary_counts": {"$ref": "#/$defs/zero_boundaries"},
    "outbound_contacts": {"const": 0},
    "candidate_content_opened": {"const": false},
    "source_content_opened": {"const": false},
    "panel_inputs_allowed": {"const": true},
    "status": {"const": "verified_for_advisory_panel_only"},
    "g2_passage": {"const": false}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "zero_boundaries": {
      "type": "object",
      "required": ["result_url_requests", "landing_page_requests", "source_file_requests", "head_requests", "redirects_followed", "persisted_snippets", "persisted_source_excerpts", "persisted_target_facts"],
      "properties": {
        "result_url_requests": {"const": 0},
        "landing_page_requests": {"const": 0},
        "source_file_requests": {"const": 0},
        "head_requests": {"const": 0},
        "redirects_followed": {"const": 0},
        "persisted_snippets": {"const": 0},
        "persisted_source_excerpts": {"const": 0},
        "persisted_target_facts": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
