{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/g2_owner_adjudication.schema.json",
  "title": "Sole-owner G2 evidence and gate adjudication",
  "type": "object",
  "required": [
    "schema_version", "decision_id", "decided_at", "owner_identity", "owner_role",
    "packet_id", "packet_sha256", "panel_synthesis", "decision_scope",
    "source_dispositions", "methods_dispositions", "concordance_disposition",
    "rights_security_disposition", "operations_disposition", "risk_dispositions",
    "work_item_dispositions", "maturity_dispositions", "gate_decision",
    "conditions", "review_or_expiry_date", "reopen_triggers",
    "publication_authorized", "immutable_reference", "pre_decision_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"type": "string", "pattern": "^D-G2-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "decided_at": {"type": "string", "format": "date-time"},
    "owner_identity": {"type": "string", "minLength": 2},
    "owner_role": {"const": "repository owner and sole accountable decision-maker"},
    "packet_id": {"type": "string", "pattern": "^G2PKT-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "panel_synthesis": {"$ref": "#/$defs/artifact"},
    "decision_scope": {"type": "string", "minLength": 10},
    "source_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "methods_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "concordance_disposition": {"$ref": "#/$defs/disposition"},
    "rights_security_disposition": {"$ref": "#/$defs/disposition"},
    "operations_disposition": {"$ref": "#/$defs/disposition"},
    "risk_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "work_item_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "maturity_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}},
    "gate_decision": {"enum": ["accept", "conditional", "reject", "defer"]},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "review_or_expiry_date": {"type": ["string", "null"], "format": "date"},
    "reopen_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "publication_authorized": {"const": false},
    "immutable_reference": {"type": "string", "minLength": 8},
    "pre_decision_manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "disposition": {
      "type": "object", "required": ["subject_id", "decision", "rationale", "evidence_references"],
      "properties": {
        "subject_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["accept", "fix", "defer", "reject", "quarantine", "exclude"]},
        "rationale": {"type": "string", "minLength": 3},
        "evidence_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
