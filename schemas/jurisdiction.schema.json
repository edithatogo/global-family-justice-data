{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/jurisdiction.schema.json",
  "title": "Jurisdiction register row",
  "type": "object",
  "required": [
    "jurisdiction_id",
    "name",
    "level",
    "parent_jurisdiction_id",
    "legal_system_family",
    "search_languages",
    "pilot_phase",
    "coverage_status",
    "notes"
  ],
  "properties": {
    "jurisdiction_id": {
      "type": "string",
      "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"
    },
    "name": {"type": "string", "minLength": 2},
    "level": {
      "enum": ["international", "national", "national_federal", "country_system", "state", "province", "territory", "other_subnational"]
    },
    "parent_jurisdiction_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"
    },
    "legal_system_family": {
      "enum": ["common_law", "civil_law", "mixed", "mixed_common_law", "religious", "customary", "multi-system", "other"]
    },
    "search_languages": {"type": "string", "minLength": 2},
    "pilot_phase": {"enum": ["1", "2", "3", "not_assigned"]},
    "coverage_status": {
      "enum": [
        "not_started",
        "search_in_progress",
        "official_source_found",
        "non_government_source_only",
        "no_public_family_specific_source_found",
        "source_inaccessible_or_rights_restricted",
        "direct_contact_pending",
        "verified_complete"
      ]
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
