{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_metadata_expansion_plan.schema.json",
  "type": "object",
  "required": ["schema_version", "plan_id", "status", "predecessor_plan_id", "baseline_frame", "url_resolution_manifest", "query_registry", "frame_contract", "roles", "search_streams", "query_templates", "year_order", "query_materialization", "search_index_stage", "official_host_policy", "recording_policy", "eligibility_rules", "selection_policy", "budgets", "stopping_rules", "next_owner_decision_requires", "later_unauthorized_stages", "authorization_flags"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"const": "G2HOLDOUT-METADATA-EXPANSION-20260815-01"},
    "status": {"const": "prepared_not_authorized"},
    "predecessor_plan_id": {"const": "G2HOLDOUT-STRUCTURAL-PREFLIGHT-20260815-01"},
    "baseline_frame": {"$ref": "#/$defs/artifact"},
    "url_resolution_manifest": {"$ref": "#/$defs/artifact"},
    "query_registry": {"$ref": "#/$defs/artifact"},
    "frame_contract": {
      "type": "object",
      "required": ["baseline_records", "new_records", "final_records", "preserve_baseline_verbatim", "silent_shrink", "adaptive_replenishment", "source_content_access"],
      "properties": {
        "baseline_records": {"const": 44}, "new_records": {"const": 52}, "final_records": {"const": 96},
        "preserve_baseline_verbatim": {"const": true}, "silent_shrink": {"const": false},
        "adaptive_replenishment": {"const": false}, "source_content_access": {"const": false}
      },
      "additionalProperties": false
    },
    "roles": {"const": [{"role_id": "metadata_expansion_registrar", "fresh_session_required": true, "network_mode": "search_index_only", "may_read_source_files": false, "may_be_extractor_or_comparator": false, "outputs": ["search_receipt", "candidate_hypothesis_universe", "search_access_receipt"]}, {"role_id": "metadata_expansion_exposure_auditor", "fresh_session_required": true, "network_mode": "disabled", "may_read_source_files": false, "may_be_extractor_or_comparator": false, "outputs": ["cumulative_exposure_ledger", "non_overlap_receipt"]}, {"role_id": "metadata_expansion_selector", "fresh_session_required": true, "network_mode": "disabled", "may_read_source_files": false, "may_be_extractor_or_comparator": false, "outputs": ["expanded_frame", "selection_receipt"]}]},
    "search_streams": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "object", "required": ["stream_id", "required_new_records", "languages", "jurisdiction_order"], "properties": {"stream_id": {"enum": ["english_text_native", "non_english_text_native", "embedded_raster_or_dashboard_pdf", "structurally_complex_mixed_layout_pdf"]}, "required_new_records": {"const": 13}, "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "jurisdiction_order": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false}
    },
    "query_templates": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["query_id", "template", "per_jurisdiction_limit"], "properties": {"query_id": {"enum": ["Q1", "Q2", "Q3", "Q4"]}, "template": {"type": "string", "minLength": 10}, "per_jurisdiction_limit": {"const": 1}}, "additionalProperties": false}},
    "year_order": {"const": [2025, 2024, 2023, 2022]},
    "query_materialization": {"type": "object", "required": ["loop_order", "year_formula", "variable_source", "whitespace_rule", "expected_query_count", "runtime_placeholder_allowed"], "properties": {"loop_order": {"const": ["search_streams", "jurisdiction_order", "query_templates"]}, "year_formula": {"const": "year_order[(stream_index * 13 + jurisdiction_index) modulo 4]"}, "variable_source": {"const": "query_registry.entries[jurisdiction_id]"}, "whitespace_rule": {"const": "collapse Unicode whitespace and trim"}, "expected_query_count": {"const": 208}, "runtime_placeholder_allowed": {"const": false}}, "additionalProperties": false},
    "search_index_stage": {"type": "object", "required": ["authorized_tool_class", "direct_url_open_allowed", "result_url_request_allowed", "landing_page_request_allowed", "file_request_allowed", "head_request_allowed", "redirect_following_allowed", "persisted_result_fields", "persist_verbatim_snippet", "receipt_requires_tool_name_and_version", "receipt_requires_query_and_result_hashes", "receipt_requires_violation_log", "enforcement_claim"], "properties": {"authorized_tool_class": {"const": "public_search_index_query_only"}, "direct_url_open_allowed": {"const": false}, "result_url_request_allowed": {"const": false}, "landing_page_request_allowed": {"const": false}, "file_request_allowed": {"const": false}, "head_request_allowed": {"const": false}, "redirect_following_allowed": {"const": false}, "persisted_result_fields": {"const": ["query_id", "query_text", "language", "searched_on", "result_rank", "result_title", "result_url", "result_domain", "access_issue"]}, "persist_verbatim_snippet": {"const": false}, "receipt_requires_tool_name_and_version": {"const": true}, "receipt_requires_query_and_result_hashes": {"const": true}, "receipt_requires_violation_log": {"const": true}, "enforcement_claim": {"const": "procedural_agent_tool_boundary_not_os_proxy_attestation"}}, "additionalProperties": false},
    "official_host_policy": {"const": {"public_https_only": true, "accept_government_or_court_hosts_only": true, "search_result_host_requires_official_html_confirmation": true, "redirect_to_file_endpoint": "block", "unknown_host": "reject"}},
    "recording_policy": {"const": {"record_query_language_date_result_url_title_access_status": true, "persist_search_snippets": false, "persist_source_excerpts": false, "persist_target_facts": false, "pdf_urls_are_unrequested_hypotheses": true, "rights_privacy_security_are_preliminary": true}},
    "eligibility_rules": {"const": {"must_be_new_edition_id": true, "must_be_new_source_series_id": true, "must_not_overlap_cumulative_exposure_denylist": true, "must_have_official_html_metadata": true, "must_have_stable_title_and_period": true, "metadata_plausibility_rule": "query_registry.metadata_plausibility.rule", "must_have_pdf_locator_hypothesis": true, "source_format_must_not_be_requested": true, "uncertain_identity": "reject"}},
    "selection_policy": {"const": {"candidate_order": ["stream_order", "jurisdiction_order", "year_order", "query_order", "canonical_url"], "select_first_eligible_per_stream": 13, "cross_stream_duplicate_policy": "lowest_stream_order_wins", "edition_and_series_uniqueness": true, "exact_new_record_count": 52}},
    "budgets": {"type": "object", "required": ["maximum_search_queries", "maximum_official_html_gets", "maximum_total_gets", "maximum_redirects_followed", "maximum_response_bytes_per_html_page", "maximum_elapsed_minutes", "maximum_retries"], "properties": {"maximum_search_queries": {"const": 208}, "maximum_official_html_gets": {"const": 0}, "maximum_total_gets": {"const": 208}, "maximum_redirects_followed": {"const": 0}, "maximum_response_bytes_per_html_page": {"const": 2097152}, "maximum_elapsed_minutes": {"const": 360}, "maximum_retries": {"const": 0}}, "additionalProperties": false},
    "stopping_rules": {"const": ["any_pdf_or_file_request_attempted", "any_head_request_attempted", "any_source_content_opened_rendered_or_downloaded", "any_unapproved_host_or_redirect_requested", "any_budget_exceeded", "any_role_or_access_receipt_violation", "any_result_or_landing_url_requested", "any baseline record changed", "any duplicate edition_or_series_in_selected_additions"]},
    "next_owner_decision_requires": {"const": ["search_index_receipt", "candidate_hypothesis_universe", "cumulative_exposure_ledger", "non_overlap_receipt", "proposed_official_html_allowlist", "role_separated_agent_panel_reports", "detached_manifest", "signed_freeze_commit"]},
    "later_unauthorized_stages": {"const": {"official_html_get_budget": 104, "required_new_compliant_records": 52, "expanded_frame_records": 96, "requires_separate_owner_decision": true}},
    "authorization_flags": {"type": "object", "required": ["metadata_expansion_prepared", "metadata_expansion_execution_authorized", "source_file_request_authorized", "structural_inspection_authorized", "extraction_authorized", "outbound_contact_authorized", "publication_authorized", "release_authorized", "g2_passage_authorized"], "properties": {"metadata_expansion_prepared": {"const": true}, "metadata_expansion_execution_authorized": {"const": false}, "source_file_request_authorized": {"const": false}, "structural_inspection_authorized": {"const": false}, "extraction_authorized": {"const": false}, "outbound_contact_authorized": {"const": false}, "publication_authorized": {"const": false}, "release_authorized": {"const": false}, "g2_passage_authorized": {"const": false}}, "additionalProperties": false}
  },
  "$defs": {"artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
