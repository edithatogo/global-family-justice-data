    "stages": {"const": {"structural_preflight": {"candidate_rejection_continues_in_frozen_order": true, "smallest_feasible_prefix_stops_inspection": true, "target_extraction_or_transcription_allowed": false, "persist_source_text_screenshots_ocr_or_target_locators": false, "structural_role_may_be_extractor_or_comparator": false}, "extraction": {"primary_count": 24, "reserve_count": 6, "primary_per_stratum": 6, "minimum_jurisdictions": 12, "maximum_selected_per_jurisdiction": 2, "maximum_selected_per_source_series": 1, "reserve_allocation": {"embedded_raster_or_dashboard_pdf": 2, "structurally_complex_mixed_layout_pdf": 2, "non_english_text_native": 1, "english_text_native": 1}, "assignment_algorithm": "smallest_prefix_then_slot_order_rank_ascending_backtracking_v1", "primary_and_secondary_fresh_sessions": true, "extractor_bundle_contains_primary_only": true, "extractors_may_read_preflight_outputs": false, "reserve_substitution_after_seal": false}}},
