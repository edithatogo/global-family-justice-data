{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/agent_panel_report.schema.json",
  "title": "Digest-bound advisory agent-panel report",
  "type": "object",
  "required": [
    "schema_version", "report_id", "packet_id", "packet_sha256", "role",
    "agent_session_id", "tool_or_model", "tool_or_model_version", "generated_at",
    "evidence_inputs", "verdict", "findings", "options", "recommendation",
    "rationale", "conflicts", "abstentions", "dissent", "authority_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "pattern": "^PANEL-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_id": {"type": "string", "minLength": 2},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "role": {"type": "string", "minLength": 2},
    "agent_session_id": {"type": "string", "minLength": 2},
    "tool_or_model": {"type": "string", "minLength": 1},
    "tool_or_model_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence_inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "verdict": {"enum": ["pass", "conditional", "fail"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "claim", "evidence_references", "uncertainty", "remediation"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "claim": {"type": "string", "minLength": 3},
          "evidence_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
          "uncertainty": {"type": "string"},
          "remediation": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["option_id", "description", "trade_offs", "limitations", "contingency"],
        "properties": {
          "option_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 3},
          "trade_offs": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "contingency": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "recommendation": {"type": "string", "minLength": 3},
    "rationale": {"type": "string", "minLength": 3},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "abstentions": {"type": "array", "items": {"type": "string"}},
    "dissent": {"type": "array", "items": {"type": "string"}},
    "authority_boundary": {"const": "advisory_only_no_gate_rights_legal_or_release_authority"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
