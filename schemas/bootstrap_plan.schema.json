{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gfjd/schemas/bootstrap_plan.schema.json",
  "title": "GFJD bootstrap plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "repository_root",
    "mode",
    "preflight",
    "accounts",
    "remote_inventory",
    "local_repositories",
    "duplicate_remote_groups",
    "portfolio_reconciliation",
    "actions",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository_root": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["plan", "apply", "verify"]},
    "preflight": {"type": "object"},
    "accounts": {
      "type": "object",
      "required": ["github", "huggingface", "resolved"],
      "properties": {
        "github": {"type": "object"},
        "huggingface": {"type": "object"},
        "resolved": {
          "type": "object",
          "required": [
            "github_owner",
            "github_repository",
            "github_slug",
            "huggingface_namespace"
          ],
          "properties": {
            "github_owner": {"type": "string"},
            "github_repository": {"type": "string"},
            "github_slug": {"type": "string"},
            "huggingface_namespace": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "remote_inventory": {"type": "object"},
    "local_repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "name", "dirty", "relevance_score"],
        "properties": {
          "path": {"type": "string"},
          "name": {"type": "string"},
          "dirty": {"type": "boolean"},
          "relevance_score": {"type": "integer"}
        },
        "additionalProperties": true
      }
    },
    "duplicate_remote_groups": {"type": "array", "items": {"type": "object"}},
    "portfolio_reconciliation": {"type": "object"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "mutating", "status", "command", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "mutating": {"type": "boolean"},
          "status": {
            "type": "string",
            "enum": ["required", "planned", "already_satisfied", "blocked", "opt_in"]
          },
          "command": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
