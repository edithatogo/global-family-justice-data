{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/indicator.schema.json",
  "title": "Indicator dictionary row",
  "type": "object",
  "required": [
    "indicator_id",
    "domain",
    "name",
    "definition",
    "preferred_statistic",
    "preferred_unit",
    "numerator",
    "denominator",
    "core_release",
    "comparability_notes"
  ],
  "properties": {
    "indicator_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
    "domain": {
      "enum": ["access", "administrative_outcome", "child_family_outcome", "demand", "equity", "experience", "flow", "inputs", "outputs", "process", "timeliness"]
    },
    "name": {"type": "string", "minLength": 3},
    "definition": {"type": "string", "minLength": 20},
    "preferred_statistic": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "preferred_unit": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"},
    "numerator": {"type": "string"},
    "denominator": {"type": "string"},
    "core_release": {"enum": ["yes", "no"]},
    "comparability_notes": {"type": "string", "minLength": 5}
  },
  "additionalProperties": false
}
