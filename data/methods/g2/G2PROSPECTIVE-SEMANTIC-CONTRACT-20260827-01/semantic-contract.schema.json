{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_prospective_semantic_contract.schema.json",
  "title": "Prospective source-independent G2 semantic contract",
  "type": "object",
  "required": ["schema_version", "contract_id", "status", "scope", "codebooks", "evidence_precedence", "fallback_policy", "decision_tables", "source_text_policy", "series_policy", "clock_policy", "locator_policy", "component_policy", "ambiguity_policy", "coverage_policy", "quarantine_policy", "date_policy", "comparison_policy", "schema_changes_required_before_use", "leakage_policy", "stopping_rules", "owner_decisions_required", "execution_authorized", "source_access_authorized", "publication_authorized", "release_authorized", "g2_passage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "contract_id": {"const": "G2-PROSPECTIVE-SEMANTIC-CONTRACT-20260827-01"},
    "status": {"const": "owner_adjudication_required_not_execution_authority"},
    "scope": {"const": "source_independent_semantic_and_locator_policy_for_future_calibration_or_evidence_lineages"},
    "codebooks": {"const": {"domain_code": ["source_defined", "unknown"], "matter_type_code": ["source_defined", "unknown"], "indicator_code": ["source_defined", "unknown"], "series_code": ["source_defined", "unknown"], "statistic_type": ["source_defined", "unknown"], "denominator_code": ["not_applicable", "source_defined", "unknown"], "clock_code": ["calendar_days", "not_applicable", "source_defined", "unknown", "working_days"], "cohort_code": ["source_defined", "unknown"], "counted_entity_code": ["source_defined", "unknown"], "population_scope_code": ["source_defined", "unknown"]}},
    "evidence_precedence": {"const": ["explicit_definition_text", "immediate_object_label", "containing_section_label", "bound_source_metadata"]},
    "fallback_policy": {"const": {"no_explicit_evidence": "unknown", "explicit_unmapped_source_concept": "source_defined", "multiple_equal_outcomes": "ambiguity_and_hard_quarantine", "no_rule_or_multiple_rule_match": "contract_failure_stop"}},
    "decision_tables": {"const": {"semantic_facets": ["explicit_nonempty_source_concept=>source_defined", "no_explicit_source_concept=>unknown", "conflicting_explicit_source_concepts=>unknown"], "series": ["explicit_series_label=>source_defined", "no_explicit_series_label=>null", "conflicting_series_labels=>unknown"], "clock": ["explicit_calendar_wording=>calendar_days", "explicit_working_or_business_wording=>working_days", "explicit_other_clock_wording=>source_defined", "no_clock_wording=>unknown", "measure_has_no_elapsed_time_semantics=>not_applicable", "conflicting_clock_wording=>unknown"], "denominator": ["explicit_denominator_definition=>source_defined", "measure_requires_no_denominator=>not_applicable", "no_required_denominator_evidence=>unknown", "conflicting_denominator_definitions=>unknown"], "components": ["all_rows=>empty_object"], "quarantine": ["all_calibration_rows=>hard_quarantine"], "rule_precedence": ["conflict_rule", "explicit_evidence_rule", "not_applicable_rule", "absence_rule"]}},
    "source_text_policy": {"const": {"normalization": ["unicode_nfc", "whitespace_collapse"], "translation": false, "recasing": false, "repunctuation": false, "paraphrase": false, "fabricated_absence_label": false}},
    "series_policy": {"const": {"explicit_or_prospectively_bound_only": true, "no_established_series": {"series_label_source": null, "series_code": null}, "explicit_unmapped_series_code": "source_defined"}},
    "clock_policy": {"const": {"calendar_requires_explicit_wording": true, "working_requires_explicit_wording": true, "year_or_period_label_alone": "unknown", "other_explicit_clock": "source_defined", "no_clock_evidence": "unknown", "not_applicable_requires_measure_without_elapsed_time_clock": true}},
    "locator_policy": {"const": {"pdf_page": "one_based_bound_pdf_page_containing_value", "printed_page": "explicit_printed_arabic_number_otherwise_null", "section": "narrowest_explicit_heading_containing_observation_otherwise_null", "object": "immediate_explicit_table_figure_box_or_equivalent_identifier_otherwise_null", "multi_page_object": "page_containing_reported_value", "composite_locator": false}},
    "component_policy": {"const": {"mode": "empty_only_until_component_provenance_schema", "invented_keys": false, "denominators_as_components": false, "nearby_values_as_components": false}},
    "ambiguity_policy": {"const": {"codes_are_material_unresolved_conditions": true, "nonempty_codes_require_source_evidence": true, "conflict_requires_two_incompatible_in_scope_statements": true, "absence_does_not_prove_completeness": true, "ontology_gap_disposition": "explicit_source_concept_maps_to_source_defined_absent_or_conflict_maps_to_unknown"}},
    "coverage_policy": {"const": {"explicit_limitation": "quote_and_apply_coverage_limitation", "no_explicit_limitation": "null_not_full_coverage_claim", "actual_completeness_without_evidence": "unknown"}},
    "quarantine_policy": {"const": {"calibration_default": "hard_quarantine", "hard_quarantine_triggers": ["all_calibration_rows", "unresolved_source_identity", "unresolved_value_or_unit", "unresolved_locator", "unresolved_counted_entity_or_population", "unresolved_required_denominator", "unresolved_material_cohort_or_clock", "material_semantic_conflict", "disclosure_or_safety_uncertainty"], "agreement_alone_allows_downgrade": false}},
    "date_policy": {"const": {"explicit_exact_edition_or_prospectively_bound_calendar_only": true, "otherwise": "null_with_not_stated_provenance"}},
    "comparison_policy": {"type": "object", "required": ["critical_concordance", "overall_populated_concordance", "exact", "fuzzy_matching", "critical_waiver", "failed_output_repair_or_reuse", "automatic_rerun"], "properties": {"critical_concordance": {"const": 1.0}, "overall_populated_concordance": {"const": 0.99}, "exact": {"const": true}, "fuzzy_matching": {"const": false}, "critical_waiver": {"const": false}, "failed_output_repair_or_reuse": {"const": false}, "automatic_rerun": {"const": false}}, "additionalProperties": false},
    "schema_changes_required_before_use": {"const": ["locator_pdf_page_nullable_for_non_pdf_sources", "locator_section_source_nullable_when_absent", "locator_object_source_nullable_when_absent", "cohort_definition_quote_nullable_when_absent", "closed_codebook_enums_bound_to_contract_version"]},
    "leakage_policy": {"const": {"sample_specific_content_allowed": false, "prohibited_classes": ["sample_or_candidate_identifiers", "jurisdictions", "source_or_edition_identifiers", "document_titles", "source_headings_or_quotes", "page_or_cell_coordinates", "observed_values", "prior_differences_or_answers", "prior_artifact_paths_or_hashes"], "synthetic_examples_only": true, "lexical_and_semantic_review_required": true, "candidate_selection_after_contract_freeze": true, "current_semantic_review_status": "inconclusive_non_independent", "same_failed_cohort_reuse": false}},
    "stopping_rules": {"const": ["open_codebook_without_deterministic_fallback", "ambiguous_or_missing_rule_precedence", "sample_specific_leakage_detected_or_not_excluded", "schema_contract_validator_comparator_or_instructions_not_digest_bound", "candidate_membership_known_during_substantive_rule_drafting", "role_separation_or_workspace_isolation_not_demonstrated", "any_post_freeze_contract_change"]},
    "owner_decisions_required": {"const": ["approve_minimal_source_defined_or_unknown_ontology", "approve_evidence_and_rule_precedence", "approve_truthful_nullability_schema_changes", "approve_empty_only_component_policy", "approve_all_calibration_rows_hard_quarantined", "choose_whether_to_authorize_a_separate_future_calibration_on_different_materials"]},
    "execution_authorized": {"const": false}, "source_access_authorized": {"const": false}, "publication_authorized": {"const": false}, "release_authorized": {"const": false}, "g2_passage": {"const": false}
  },
  "additionalProperties": false
}
