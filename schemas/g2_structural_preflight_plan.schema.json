    "candidate_rejection_codes": {"const": ["unavailable_after_frozen_retries", "wrong_mime_or_pdf_magic", "edition_or_url_drift", "resource_limit_exceeded", "encrypted_or_malformed", "unsafe_active_or_embedded_content", "structural_class_indeterminate", "not_official_or_not_exact_edition", "not_aggregate_only", "personal_case_level_or_prohibited_data", "local_private_processing_not_approved", "prior_exposure_discovered"]},
