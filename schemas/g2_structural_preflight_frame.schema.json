{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_structural_preflight_frame.schema.json",
  "title": "Frozen metadata frame for G2 structural preflight",
  "type": "object",
  "required": ["schema_version", "frame_id", "plan_id", "metadata_only", "source_content_accessed", "ordering_seed", "ordering_algorithm", "candidate_count", "candidates", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "frame_id": {"const": "G2HOLDOUT-STRUCTURAL-FRAME-20260815-01"},
    "plan_id": {"const": "G2HOLDOUT-STRUCTURAL-PREFLIGHT-20260815-01"},
    "metadata_only": {"const": true},
    "source_content_accessed": {"const": false},
    "ordering_seed": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ordering_algorithm": {"const": "sha256_seed_nul_candidate_id_nul_edition_id_nul_series_id_ascending_v1"},
    "candidate_count": {"const": 44},
    "candidates": {
      "type": "array", "minItems": 44, "maxItems": 44,
      "items": {
        "type": "object",
        "required": ["frame_rank", "frame_score", "candidate_id", "edition_id", "jurisdiction_id", "source_series_id", "edition_title", "publisher", "languages", "landing_page_url", "source_url", "retrieval_entrypoint", "retrieval_entrypoint_kind", "metadata_provenance_urls", "proposed_stratum", "prior_metadata_eligibility", "rights_screen", "privacy_screen", "security_screen", "prohibited_data_screen", "source_content_accessed", "source_access_authorized"],
        "properties": {
          "frame_rank": {"type": "integer", "minimum": 1, "maximum": 44},
          "frame_score": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "candidate_id": {"type": "string", "minLength": 2},
          "edition_id": {"type": "string", "minLength": 2},
          "jurisdiction_id": {"type": "string", "minLength": 2},
          "source_series_id": {"type": "string", "minLength": 2},
          "edition_title": {"type": "string", "minLength": 2},
          "publisher": {"type": "string", "minLength": 2},
          "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "landing_page_url": {"type": "string", "format": "uri"},
          "source_url": {"type": ["string", "null"], "format": "uri"},
          "retrieval_entrypoint": {"type": "string", "format": "uri"},
          "retrieval_entrypoint_kind": {"enum": ["exact_pdf_url", "official_landing_page_requires_resolution"]},
          "metadata_provenance_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
          "proposed_stratum": {"type": ["string", "null"]},
          "prior_metadata_eligibility": {"enum": ["uncertain", "eligible_metadata_only"]},
          "rights_screen": {"type": "string"}, "privacy_screen": {"type": "string"}, "security_screen": {"type": "string"}, "prohibited_data_screen": {"type": "string"},
          "source_content_accessed": {"const": false}, "source_access_authorized": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
