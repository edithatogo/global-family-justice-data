{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_metadata_search_successor_authority_receipt.schema.json",
  "type": "object",
  "required": ["schema_version", "receipt_id", "generated_at", "design_manifest", "freeze_commit", "freeze_commit_object_type", "freeze_signature", "owner_decision", "owner_decision_commit", "owner_decision_commit_object_type", "owner_decision_signature", "tree_bindings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"pattern": "^G2-METADATA-SEARCH-SUCCESSOR-AUTHORITY-[0-9]{8}-[0-9]{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "design_manifest": {"$ref": "#/$defs/artifact"},
    "freeze_commit": {"$ref": "#/$defs/commit"},
    "freeze_commit_object_type": {"const": "commit"},
    "freeze_signature": {"$ref": "#/$defs/signature"},
    "owner_decision": {"$ref": "#/$defs/artifact"},
    "owner_decision_commit": {"$ref": "#/$defs/commit"},
    "owner_decision_commit_object_type": {"const": "commit"},
    "owner_decision_signature": {"$ref": "#/$defs/signature"},
    "tree_bindings": {
      "type": "object",
      "required": ["freeze_commit_contains_design_manifest", "owner_decision_commit_contains_owner_decision"],
      "properties": {
        "freeze_commit_contains_design_manifest": {"const": true},
        "owner_decision_commit_contains_owner_decision": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "signature": {
      "type": "object",
      "required": ["command", "status", "verified_at"],
      "properties": {
        "command": {"const": ["git", "verify-commit"]},
        "status": {"const": "good"},
        "verified_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
