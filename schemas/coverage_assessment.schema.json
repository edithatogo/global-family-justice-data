{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/coverage_assessment.schema.json",
  "title": "Jurisdiction coverage assessment record",
  "type": "object",
  "required": [
    "assessment_id",
    "jurisdiction_id",
    "assessed_at",
    "assessor_role",
    "coverage_state",
    "official_source_state",
    "negative_finding_state",
    "completeness_basis",
    "next_review_due",
    "review_status",
    "evidence_path",
    "notes"
  ],
  "properties": {
    "assessment_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "assessor_role": {"type": "string", "minLength": 2},
    "coverage_state": {"enum": ["not_started", "partial", "candidate_complete", "verified_complete", "stale"]},
    "official_source_state": {"enum": ["found", "not_found", "inaccessible", "not_applicable", "unknown"]},
    "negative_finding_state": {"enum": ["not_assessed", "documented", "reviewed", "accepted"]},
    "completeness_basis": {"type": "string"},
    "next_review_due": {"type": ["string", "null"], "format": "date"},
    "review_status": {"enum": ["draft", "reviewed", "accepted", "rejected", "superseded"]},
    "evidence_path": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
