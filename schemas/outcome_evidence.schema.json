{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/outcome_evidence.schema.json",
  "title": "Outcomes evidence catalogue row",
  "type": "object",
  "required": ["evidence_record_id", "jurisdiction_id", "matter_type_id", "title", "publisher_or_authors", "publication_year", "evidence_design", "outcome_domain", "population", "source_url", "official_status", "quality_appraisal_status", "notes"],
  "properties": {
    "evidence_record_id": {"type": "string", "pattern": "^EVC_[A-Z0-9][A-Z0-9_-]{5,95}$"},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "matter_type_id": {"type": ["string", "null"], "pattern": "^MAT_[A-Z0-9_]{2,60}$"},
    "title": {"type": "string", "minLength": 3},
    "publisher_or_authors": {"type": "string", "minLength": 2},
    "publication_year": {"type": "integer", "minimum": 1900, "maximum": 2200},
    "evidence_design": {"enum": ["administrative_linkage", "cohort", "cross_sectional", "evaluation", "qualitative", "randomised_trial", "systematic_review", "survey", "other"]},
    "outcome_domain": {"enum": ["administrative", "child_wellbeing", "family_functioning", "procedural_fairness", "safety", "stability", "user_experience", "other"]},
    "population": {"type": "string", "minLength": 2},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "official_status": {"enum": ["official", "academic", "non_government", "mixed"]},
    "quality_appraisal_status": {"enum": ["not_started", "in_progress", "complete", "not_applicable"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
