{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_metadata_search_successor_owner_decision.schema.json",
  "type": "object",
  "required": ["schema_version", "decision_id", "decision", "owner_identity", "owner_role", "decided_at", "valid_from", "valid_until", "design_manifest", "freeze_commit", "query_manifest", "authorization", "acknowledgements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"pattern": "^D-G2-METADATA-SEARCH-SUCCESSOR-[0-9]{8}-[0-9]{2}$"},
    "decision": {"const": "authorize_exact_successor_search_index_execution"},
    "owner_identity": {"type": "string", "minLength": 1},
    "owner_role": {"const": "sole_repository_owner_and_accountable_authority"},
    "decided_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "design_manifest": {"$ref": "#/$defs/artifact"},
    "freeze_commit": {"$ref": "#/$defs/commit"},
    "query_manifest": {"$ref": "#/$defs/artifact"},
    "authorization": {
      "const": {
        "successor_logical_queries": 208,
        "successor_provider_calls": 208,
        "logical_queries_per_call": 1,
        "successor_retries": 0,
        "prior_lineage_submissions": 4,
        "cumulative_lineage_submissions": 212,
        "passive_metadata_only": true,
        "result_url_requests": 0,
        "landing_page_requests": 0,
        "source_file_requests": 0,
        "head_requests": 0,
        "redirects_followed": 0
      }
    },
    "acknowledgements": {
      "const": {
        "prior_query_ids_denied": ["G2Q-001", "G2Q-002", "G2Q-003", "G2Q-004"],
        "prior_aggregate_reconstruction_complete": false,
        "unknown_prior_urls_captured": false,
        "source_access_authorized": false,
        "outbound_contact_authorized": false,
        "publication_authorized": false,
        "release_authorized": false,
        "g2_passage_authorized": false
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  },
  "additionalProperties": false
}
