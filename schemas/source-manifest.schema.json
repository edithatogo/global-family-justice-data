{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acquired source manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "source_id",
    "source_version",
    "retrieved_at",
    "canonical_url",
    "retrieval_method",
    "rights_reviewed",
    "redistribution_decision",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {"type": "string"},
    "source_id": {"type": "string", "minLength": 3},
    "source_version": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "canonical_url": {"type": "string", "format": "uri"},
    "retrieval_method": {"enum": ["download", "api", "html", "dashboard_export", "manual_receipt", "manifest_only"]},
    "query_or_filters": {"type": "object"},
    "rights_reviewed": {"type": "boolean"},
    "redistribution_decision": {"enum": ["metadata_only", "redistributable", "restricted", "not_applicable"]},
    "archive_reference": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "media_type", "size_bytes", "sha256", "stored_in_repository"],
        "properties": {
          "filename": {"type": "string"},
          "media_type": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stored_in_repository": {"type": "boolean"},
          "storage_reference": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
