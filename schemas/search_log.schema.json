{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/search_log.schema.json",
  "title": "Jurisdiction source-search log record",
  "type": "object",
  "required": [
    "search_log_id",
    "jurisdiction_id",
    "searched_at",
    "searched_by_role",
    "language",
    "domains_searched",
    "query_summary",
    "result_state",
    "evidence_path",
    "review_status",
    "notes"
  ],
  "properties": {
    "search_log_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,79}$"},
    "jurisdiction_id": {"type": "string", "pattern": "^[A-Z]{2,3}(?:-[A-Z0-9]{2,5})?$"},
    "searched_at": {"type": "string", "format": "date-time"},
    "searched_by_role": {"type": "string", "minLength": 2},
    "language": {"type": "string", "minLength": 2},
    "domains_searched": {"type": "string"},
    "query_summary": {"type": "string"},
    "result_state": {"enum": ["official_source_found", "non_government_source_only", "no_public_source_found", "source_inaccessible", "search_incomplete"]},
    "evidence_path": {"type": "string"},
    "review_status": {"enum": ["draft", "reviewed", "accepted", "rejected", "superseded"]},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
