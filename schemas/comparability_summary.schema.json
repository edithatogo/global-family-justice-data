{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/comparability_summary.schema.json",
  "title": "Comparability audit build summary",
  "type": "object",
  "required": ["schema_version", "built_on", "signature_fields", "inputs", "observation_count", "signature_count", "cross_jurisdiction_candidate_count", "issue_counts", "state_counts", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "built_on": {"type": "string", "format": "date"},
    "signature_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "observation_count": {"type": "integer", "minimum": 0},
    "signature_count": {"type": "integer", "minimum": 0},
    "cross_jurisdiction_candidate_count": {"type": "integer", "minimum": 0},
    "issue_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "state_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
