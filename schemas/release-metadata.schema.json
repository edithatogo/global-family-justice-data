{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated release metadata",
  "type": "object",
  "required": [
    "release_id",
    "version",
    "built_at",
    "build_id",
    "repository_commit",
    "schema_versions",
    "input_manifest_sha256",
    "artifacts"
  ],
  "properties": {
    "release_id": {"type": "string"},
    "version": {"type": "string"},
    "built_at": {"type": "string", "format": "date-time"},
    "build_id": {"type": "string"},
    "repository_commit": {"type": "string"},
    "schema_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "ontology_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "input_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "quality_report": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "media_type", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "media_type": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "archive_identifier": {"type": "string"},
    "known_limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
