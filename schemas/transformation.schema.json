{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transformation register row",
  "type": "object",
  "required": [
    "schema_version",
    "transformation_id",
    "name",
    "description",
    "input_layer",
    "output_layer",
    "version",
    "deterministic",
    "review_status",
    "introduced_in"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "transformation_id": {"type": "string", "minLength": 3},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "implementation_path": {"type": "string"},
    "input_layer": {"enum": ["raw", "bronze", "silver", "external"]},
    "output_layer": {"enum": ["bronze", "silver", "gold", "publication"]},
    "version": {"type": "string", "minLength": 1},
    "deterministic": {"enum": ["yes", "no", "conditional"]},
    "parameters_schema": {"type": "string"},
    "tests_path": {"type": "string"},
    "owner": {"type": "string"},
    "reviewer": {"type": "string"},
    "review_status": {"enum": ["draft", "provisional", "reviewed", "approved", "deprecated", "withdrawn"]},
    "introduced_in": {"type": "string"},
    "deprecated_in": {"type": "string"},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
