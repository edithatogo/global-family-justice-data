{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.org/schemas/g2_merged_eligibility_receipt.schema.json",
  "title": "Digest-bound merged G2 structural eligibility receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "plan_id", "frame", "structural_policy", "selection_policy", "inspected_prefix_end_rank", "records", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0"}, "receipt_id": {"type": "string", "minLength": 8},
    "plan_id": {"const": "G2HOLDOUT-STRUCTURAL-PREFLIGHT-20260815-01"},
    "frame": {"$ref": "#/$defs/artifact"}, "structural_policy": {"$ref": "#/$defs/artifact"},
    "selection_policy": {"$ref": "#/$defs/artifact"},
    "inspected_prefix_end_rank": {"type": "integer", "minimum": 1, "maximum": 44},
    "records": {"type": "array", "minItems": 1, "maxItems": 44, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"artifact": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
  "additionalProperties": false
}
