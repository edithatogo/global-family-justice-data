{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-family-justice-data.example/schemas/g2_extraction_run.schema.json",
  "title": "G2 blinded extraction run receipt",
  "type": "object",
  "required": [
    "schema_version", "run_id", "packet_id", "packet_sha256", "assignment",
    "agent_role", "agent_session_id", "tool_or_model", "tool_or_model_version",
    "instructions_sha256", "blindness_declaration", "excluded_artifact_paths",
    "started_at", "completed_at", "input_editions", "output", "row_schema",
    "validation_status", "warnings", "limitations", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^G2EXT-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_id": {"type": "string", "pattern": "^G2PKT-[A-Z0-9][A-Z0-9_-]{5,79}$"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "assignment": {"enum": ["primary", "secondary"]},
    "agent_role": {"type": "string", "minLength": 2},
    "agent_session_id": {"type": "string", "minLength": 2},
    "tool_or_model": {"type": "string", "minLength": 1},
    "tool_or_model_version": {"type": "string", "minLength": 1},
    "instructions_sha256": {"$ref": "#/$defs/sha256"},
    "blindness_declaration": {"type": "string", "minLength": 20},
    "excluded_artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "input_editions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "output": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "required": ["row_count"], "properties": {"row_count": {"type": "integer", "minimum": 0}}}
      ]
    },
    "row_schema": {"$ref": "#/$defs/artifact"},
    "validation_status": {"enum": ["passed", "failed", "not_run"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["complete", "failed", "invalidated"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "row_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
